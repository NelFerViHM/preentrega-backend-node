//     try {
//         const res = await fetch(BASE_URL);
//         if (!res.ok) throw new Error(`Error: ${res.status}`);
//         return await res.json();
//     } catch (err) {
//         console.error("❌ Error al listar productos:", err.message);
//         return null;
//     }
// }
export async function obtenerTodos() {
    try {
        const res = await fetch(BASE_URL);

        // Si la respuesta no es exitosa (ej: un 404 o 500)
        if (!res.ok) {
            throw new Error(`Error en el servidor: ${res.status}`);
        }

        // Antes de transformar a JSON, verificamos el tipo de contenido que llega
        const contentType = res.headers.get("content-type");
        if (!contentType || !contentType.includes("application/json")) {
            const textoError = await res.text();
            console.log("⚠️ El servidor no devolvió JSON. Devolvió esto:\n", textoError.slice(0, 200));
            throw new Error("La respuesta no tiene formato JSON válido.");
        }

        return await res.json();
    } catch (err) {
        console.error("❌ Error al listar productos:", err.message);
        return null;
    }
}


// 2. Obtener un producto por ID (GET /id)
export async function obtenerPorId(id) {
    try {
        const res = await fetch(`${BASE_URL}/${id}`);
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error(`❌ Error al buscar el producto ${id}:`, err.message);
        return null;
    }
}

// 3. Crear un producto nuevo (POST)
export async function crearProducto(datosProducto) {
    try {
        const res = await fetch(BASE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datosProducto)
        });
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error("❌ Error al crear producto:", err.message);
        return null;
    }
}

// 4. Eliminar un producto (DELETE)
export async function eliminarProducto(id) {
    try {
        const res = await fetch(`${BASE_URL}/${id}`, {
            method: 'DELETE'
        });
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error(`❌ Error al eliminar el producto ${id}:`, err.message);
        return null;
    }
}
