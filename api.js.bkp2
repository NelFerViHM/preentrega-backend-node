// Cambiamos la URL base a DummyJSON que está online y funcionando
const BASE_URL = 'https://dummyjson.com/products';

// 1. Obtener todos los productos (GET)
export async function obtenerTodos() {
    try {
        // limit=0 le indica a DummyJSON que traiga todos los productos juntos
        const res = await fetch(`${BASE_URL}?limit=0`);
        if (!res.ok) throw new Error(`Error: ${res.status}`);

        const data = await res.json();
        // DummyJSON envuelve el array en un objeto { products: [...] }
        return data.products;
    } catch (err) {
        console.error("❌ Error al listar productos:", err.message);
        return null;
    }
}

// 2. Obtener un producto por ID (GET /id)
export async function obtenerPorId(id) {
    try {
        const res = await fetch(`${BASE_URL}/${id}`);
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error(`❌ Error al buscar el producto ${id}:`, err.message);
        return null;
    }
}

// 3. Crear un producto nuevo (POST)
export async function crearProducto(datosProducto) {
    try {
        const res = await fetch(`${BASE_URL}/add`, { // DummyJSON usa /products/add para el POST
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datosProducto)
        });
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error("❌ Error al crear producto:", err.message);
        return null;
    }
}

// 4. Eliminar un producto (DELETE)
export async function eliminarProducto(id) {
    try {
        const res = await fetch(`${BASE_URL}/${id}`, {
            method: 'DELETE'
        });
        if (!res.ok) throw new Error(`Error: ${res.status}`);
        return await res.json();
    } catch (err) {
        console.error(`❌ Error al eliminar el producto ${id}:`, err.message);
        return null;
    }
}
